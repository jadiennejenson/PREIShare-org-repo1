# .env.example — commit this file. Never put real keys here.
# Copy to .env.local (or .env) for local development and fill in real values
# from Supabase → Project Settings → API.
#
# PUBLIC / BROWSER-SAFE (safe to expose in the client bundle)
# TanStack Start + Vite conventions use VITE_ for browser-readable variables.
# These values are okay to be shipped to the browser when RLS is enforced.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER-ONLY SECRETS (never prefix for client exposure; never import in browser code)
# Use these only in server routes, loaders, server actions, or admin jobs.
# Service role bypasses Row Level Security and must never be shipped to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
